{
    "name": "phil/microsymfony",
    "description": "A template to initialize an application to use Symfony as a micro-framework",
    "license": "MIT",
    "type": "symfony-application-template",
    "keywords": [
        "micro-framework",
        "php",
        "poc",
        "project-template",
        "rad",
        "symfony",
        "web-application"
    ],
    "homepage": "https://ph-il.ca",
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca"
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-filter": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "ext-xml": "*",
        "league/commonmark": "^2.10",
        "sentry/sentry-symfony": "^5.12",

        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2.11",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-foundation": "8.1.*",
        "symfony/http-kernel": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/routing": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-csrf": "~8.1.0",
        "symfony/stimulus-bundle": "^3.4",
        "symfony/string": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/ux-turbo": "^3.4",
        "symfony/validator": "8.1.*",
        "symfony/web-link": "8.1.*",
        "symfony/yaml": "8.1.*",
        "twig/extra-bundle": "^3.24",
        "twig/intl-extra": "^3.26",
        "twig/markdown-extra": "^3.28",
        "twig/string-extra": "^3.24",
        "twig/twig": "^3.28"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9",
        "phpunit/phpunit": "^13.2",
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.67",
        "symfony/panther": "^2.4",
        "symfony/requirements-checker": "^2.0",
        "symfony/stopwatch": "8.1.*",
        "symfony/var-dumper": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "classmap-authoritative": true,
        "audit": {
            "block-insecure": true,
	    "abandoned": "fail"
        },
        "platform": {
            "php": "8.5.0"
        },
        "sort-packages": true
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": false,
            "forward-command": true,
            "target-directory": "vendor-bin"
        },
        "symfony": {
            "allow-contrib": true,
            "require": "8.1.*",
            "docker": false
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts",
            "@composer bin php-cs-fixer install --ansi"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "app:test": [
            "vendor/bin/phpunit"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "requirements-checker": "script"
        }
    },
    "scripts-descriptions": {
        "app:test": "Run all PHPUnit tests"
    }
}
