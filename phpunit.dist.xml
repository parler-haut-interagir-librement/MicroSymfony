<?xml version="1.0" encoding="UTF-8"?>

<!--
    One suite per kind of test, each in its own directory of tests/, from the fastest to the slowest.
    Unit runs without a kernel and touches nothing. Integration boots the kernel. Api and Functional send requests
    through the kernel. E2E drives a real browser, Chrome through Panther: castor test:e2e runs it alone, outside
    castor test, castor coverage, castor ci and the continuous integration.
    Every test names what it covers, with #[CoversClass] or #[CoversNothing]: coverage counts only what a test
    sets out to test.
    No colors: castor test:coverage reads the line percentage from the text report, which PHPUnit would write with
    the escape codes of its colors.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         requireCoverageMetadata="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory="var/phpunit"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <server name="KERNEL_CLASS" value="App\Kernel" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="APP_DEBUG" value="true" />
    </php>

    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="Api">
            <directory>tests/Api</directory>
        </testsuite>
        <testsuite name="Functional">
            <directory>tests/Functional</directory>
        </testsuite>
        <testsuite name="E2E">
            <directory>tests/E2E</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>src</directory>
        </include>
    </source>

    <extensions>
        <bootstrap class="Ergebnis\PHPUnit\SlowTestDetector\Extension" />
        <!-- The web server of Panther, started by the first E2E test and stopped at the end of the run. -->
        <bootstrap class="Symfony\Component\Panther\ServerExtension" />
    </extensions>
</phpunit>
